# GLMproxy + AutoClaw watchdog
# Dipanggil Scheduled Task "GLMproxy-Watchdog" tiap 2 menit (hidden, tanpa jendela).
# Tugasnya: pastiin AutoClaw hidup, dan port 18791/18792 (GLMproxy) hidup.
# Kalau mati -> dinyalain lagi otomatis. Nggak dobel karena dicek port dulu.

$ErrorActionPreference = 'SilentlyContinue'

$base     = 'D:\ToolsAI\glmproxy'
$cli      = Join-Path $base 'node_modules\glmproxy\bin\cli.js'
$autoClaw = 'D:\Desktop\AutoClaw2\AutoClaw2.exe'
$log      = Join-Path $base 'logs\watchdog.log'

function Write-Log($msg) {
    $line = "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')  $msg"
    Add-Content -Path $log -Value $line -Encoding utf8
}

# --- jangan jalan dobel ---
$mutex = New-Object System.Threading.Mutex($false, 'Global\GLMproxyWatchdog')
if (-not $mutex.WaitOne(0)) { exit 0 }

try {
    if (-not (Test-Path (Join-Path $base 'logs'))) {
        New-Item -ItemType Directory -Force -Path (Join-Path $base 'logs') | Out-Null
    }

    # --- 1. AutoClaw harus hidup (sumber token) ---
    if (-not (Get-Process -Name 'AutoClaw2' -ErrorAction SilentlyContinue)) {
        if (Test-Path $autoClaw) {
            Start-Process -FilePath $autoClaw -WindowStyle Minimized
            Write-Log 'AutoClaw: MATI -> dinyalakan'
            Start-Sleep -Seconds 20   # kasih waktu baca vault
        } else {
            Write-Log "AutoClaw: exe tidak ditemukan ($autoClaw)"
        }
    }

    # --- 2. GLMproxy: cek port, nyalakan yang mati saja ---
    $targets = @(
        @{ Port = 18791; Mode = '--openai';    File = 'openai.log' },
        @{ Port = 18792; Mode = '--anthropic'; File = 'anthropic.log' }
    )

    foreach ($t in $targets) {
        $listen = Get-NetTCPConnection -LocalPort $t.Port -State Listen -ErrorAction SilentlyContinue
        if ($listen) { continue }

        $env:GLMP_IDENTITY_VERSION   = '2.0.3'
        $env:BUDGET_REQUESTS_PER_HOUR = '300'
        $env:GLMP_QUEUE              = '0'   # paralel ON: upstream terima multi-generasi (tes 4 concurrent 200 OK, 2026-11-06)

        $args = "/c node `"$cli`" $($t.Mode) --port $($t.Port) --key mewmew >> `"$base\logs\$($t.File)`" 2>&1"
        Start-Process -FilePath 'cmd.exe' -ArgumentList $args -WindowStyle Hidden
        Write-Log "GLMproxy: port $($t.Port) MATI -> dinyalakan ($($t.Mode))"
    }
}
finally {
    $mutex.ReleaseMutex()
    $mutex.Dispose()
}

